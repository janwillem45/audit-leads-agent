# Kopieer naar .env en vul in. .env staat in .gitignore en wordt nooit gecommit.
# Sinds 4 okt 2026 gaan leads naar Apple Herinneringen (lijst Acquisitie) op de Mac mini.
# Mail is alleen nog de terugval. EMAIL_TO leeg = naar SMTP_FROM (jezelf).
# EMAIL_TO=
# Herinneringen uitzetten en toch mailen: LEADS_NAAR_HERINNERINGEN=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=janwillem.walravens@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=janwillem.walravens@gmail.com
# EMAIL_CC=

# Optioneel: gratis API-key van https://developer.adzuna.com
# Zonder deze keys wordt de Adzuna-bron stilletjes overgeslagen.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
